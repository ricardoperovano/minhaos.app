---
import { links, nav, site } from '../site.config'
const path = Astro.url.pathname
---

<header class="site-header">
  <div class="container bar">
    <a href="/" class="logo" aria-label={`${site.name} — página inicial`}>
      <img src="/brand/logo-horizontal.svg" alt="" width="173" height="30" />
    </a>
    <nav aria-label="Principal" class="nav">
      <details class="menu">
        <summary aria-label="Abrir menu">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          <span>Menu</span>
        </summary>
        <ul>
          {nav.map((n) => (
            <li>
              <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>
                {n.label}
              </a>
            </li>
          ))}
          <li class="only-mobile"><a href={links.login}>Entrar</a></li>
        </ul>
      </details>
    </nav>
    <div class="actions">
      <a href={links.login} class="login">Entrar</a>
      <a href={links.signup} class="btn btn-primary">Criar conta</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 0.96);
    border-bottom: 1px solid var(--border);
    backdrop-filter: saturate(1.4) blur(6px);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 68px;
  }
  .logo {
    display: flex;
    flex-shrink: 0;
  }
  .nav {
    flex: 1;
  }
  .menu summary {
    display: none;
  }
  .menu ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu a {
    display: block;
    padding: 8px 12px;
    border-radius: 8px;
    color: var(--text-2);
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
  }
  .menu a:hover,
  .menu a[aria-current='page'] {
    color: var(--navy);
    background: var(--surface-muted);
  }
  .only-mobile {
    display: none;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .login {
    color: var(--navy);
    font-weight: 600;
    text-decoration: none;
    font-size: 15px;
  }
  @media (max-width: 960px) {
    .bar {
      gap: 12px;
    }
    .nav {
      order: 3;
      flex: 0;
    }
    .menu summary {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      min-height: 44px;
      padding: 0 10px;
      border: 1px solid var(--border-strong);
      border-radius: 8px;
      cursor: pointer;
      list-style: none;
      color: var(--navy);
      font-weight: 600;
      font-size: 15px;
    }
    .menu summary::-webkit-details-marker {
      display: none;
    }
    .menu ul {
      display: none;
    }
    .menu[open] ul {
      display: flex;
      flex-direction: column;
      position: absolute;
      left: 0;
      right: 0;
      top: 68px;
      background: #fff;
      border-bottom: 1px solid var(--border);
      padding: 8px 20px 16px;
      box-shadow: 0 8px 24px rgb(15 23 42 / 0.12);
    }
    .menu[open] a {
      padding: 12px;
      font-size: 17px;
    }
    .only-mobile {
      display: block;
    }
    .actions {
      margin-left: auto;
    }
    .login {
      display: none;
    }
  }
  @media (max-width: 420px) {
    .logo img {
      width: 140px;
    }
    .actions .btn {
      padding: 0 14px;
      font-size: 15px;
    }
  }
</style>
