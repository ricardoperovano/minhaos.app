---
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import Cta from '../components/Cta.astro'
import { clusters, site } from '../site.config'
import { abs, breadcrumbLd, faqLd, formatDate, graph, organizationLd, readingMinutes } from '../lib/seo'
import { tools } from '../lib/tools'
import Base from './Base.astro'

interface Props {
  entry: CollectionEntry<'guias'>
  headings: Array<{ depth: number; slug: string; text: string }>
}
const { entry, headings } = Astro.props
const d = entry.data
const path = `/guias/${entry.id}/`
const cluster = clusters[d.cluster]
const all = await getCollection('guias')
const related = d.related.map((s) => all.find((g) => g.id === s)).filter((g): g is NonNullable<typeof g> => !!g)
// Completa com guias do mesmo tema para garantir links internos.
for (const g of all.filter((g) => g.data.cluster === d.cluster && g.id !== entry.id)) {
  if (related.length >= 4) break
  if (!related.includes(g)) related.push(g)
}
const toc = headings.filter((h) => h.depth === 2)
const minutes = readingMinutes(entry.body ?? '')
const crumbs = [
  { name: 'Início', href: '/' },
  { name: 'Guias', href: '/guias/' },
  { name: cluster.title, href: `/guias/tema/${d.cluster}/` },
  { name: d.h1, href: path },
]
const article = {
  '@type': 'Article',
  '@id': `${abs(path)}#article`,
  headline: d.h1,
  description: d.description,
  inLanguage: 'pt-BR',
  datePublished: d.publishedAt.toISOString(),
  dateModified: d.updatedAt.toISOString(),
  mainEntityOfPage: abs(path),
  image: abs('/og/default.png'),
  author: { '@id': `${site.url}/#organization` },
  publisher: { '@id': `${site.url}/#organization` },
  articleSection: cluster.title,
  keywords: [d.keyword, ...d.keywords].join(', '),
  wordCount: (entry.body ?? '').split(/\s+/).length,
}
const ld = graph(organizationLd, article, breadcrumbLd(crumbs), ...(d.faq.length ? [faqLd(d.faq)] : []))
const tool = d.tool ? { key: d.tool, ...tools[d.tool] } : null
---

<Base title={d.title} description={d.description} path={path} type="article" jsonLd={ld} published={d.publishedAt} modified={d.updatedAt}>
  <article class="container guide">
    <header class="head">
      <Breadcrumbs items={crumbs} />
      <a class="eyebrow" href={`/guias/tema/${d.cluster}/`}>{cluster.title}</a>
      <h1>{d.h1}</h1>
      <p class="lead">{d.description}</p>
      <p class="meta small">
        Atualizado em <time datetime={d.updatedAt.toISOString()}>{formatDate(d.updatedAt)}</time> · {minutes} min de leitura · Equipe {site.name}
      </p>
    </header>

    <div class="layout">
      {
        toc.length > 2 && (
          <aside class="toc no-print" aria-label="Neste guia">
            <p class="toc-title">Neste guia</p>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
              {d.faq.length > 0 && (
                <li>
                  <a href="#perguntas-frequentes">Perguntas frequentes</a>
                </li>
              )}
            </ol>
          </aside>
        )
      }
      <div class="body prose">
        <slot />

        {
          tool && (
            <div class="callout tool no-print">
              <p class="t">Ferramenta grátis: {tool.title}</p>
              <p>{tool.description}</p>
              <a href={`/ferramentas/${tool.key}/`} class="btn btn-primary">
                Usar a ferramenta
              </a>
            </div>
          )
        }

        {
          d.faq.length > 0 && (
            <section aria-labelledby="perguntas-frequentes">
              <h2 id="perguntas-frequentes">Perguntas frequentes</h2>
              {d.faq.map((f) => (
                <details class="faq">
                  <summary>{f.q}</summary>
                  <p>{f.a}</p>
                </details>
              ))}
            </section>
          )
        }

        {
          d.sources.length > 0 && (
            <section class="sources" aria-labelledby="fontes">
              <h2 id="fontes">Fontes consultadas</h2>
              <ul>
                {d.sources.map((s) => (
                  <li>
                    <a href={s.url} rel="noopener" target="_blank">
                      {s.title}
                    </a>
                  </li>
                ))}
              </ul>
              <p class="small">Informações sobre regras fiscais e legais podem mudar. Confirme com seu contador ou nos canais oficiais antes de decidir.</p>
            </section>
          )
        }

        <Cta />
      </div>
    </div>

    {
      related.length > 0 && (
        <section class="related no-print" aria-labelledby="relacionados">
          <h2 id="relacionados">Continue lendo</h2>
          <div class="grid grid-2">
            {related.slice(0, 4).map((g) => (
              <a class="card" href={`/guias/${g.id}/`}>
                <span class="eyebrow">{clusters[g.data.cluster].title}</span>
                <h3>{g.data.h1}</h3>
                <p class="muted small">{g.data.description}</p>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </article>
</Base>

<style>
  .guide {
    padding-block: 32px 64px;
  }
  .head {
    max-width: 820px;
  }
  .lead {
    font-size: 19px;
    color: var(--text-2);
  }
  .meta {
    margin-bottom: 32px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
  }
  @media (min-width: 1040px) {
    .layout {
      grid-template-columns: 240px minmax(0, 1fr);
    }
    .toc {
      position: sticky;
      top: 92px;
      align-self: start;
    }
  }
  .toc-title {
    font-weight: 650;
    color: var(--navy);
    font-size: 15px;
    margin-bottom: 8px;
  }
  .toc ol {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 2px solid var(--border);
  }
  .toc li {
    margin: 0;
  }
  .toc a {
    display: block;
    padding: 6px 0 6px 14px;
    font-size: 14px;
    line-height: 1.4;
    color: var(--text-2);
    text-decoration: none;
  }
  .toc a:hover {
    color: var(--teal);
  }
  .body :global(h2) {
    scroll-margin-top: 92px;
  }
  .faq {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    margin-bottom: 10px;
    background: #fff;
  }
  .faq summary {
    cursor: pointer;
    padding: 14px 16px;
    font-weight: 600;
    color: var(--navy);
  }
  .faq p {
    padding: 0 16px 14px;
    margin: 0;
  }
  .tool {
    background: var(--teal-subtle);
    border-color: #99f6e4;
  }
  .tool .t {
    font-weight: 650;
    color: var(--navy);
    margin-bottom: 4px;
  }
  .sources ul {
    font-size: 15px;
  }
  .related {
    margin-top: 32px;
    border-top: 1px solid var(--border);
    padding-top: 8px;
  }
</style>
