---
import '@fontsource-variable/inter/wght.css'
import '../styles/global.css'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import Seo from '../components/Seo.astro'

type SeoProps = Parameters<typeof Seo>[0]
type Props = SeoProps
const props = Astro.props
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <Seo {...props} />
    <slot name="head" />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-7RYM7B1WPC"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-7RYM7B1WPC');
    </script>
  </head>
  <body>
    <a href="#conteudo" class="skip">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <script is:inline async src="https://alb.monitchat.com/widget/wgt_txliEMbmtAsbbJM8rKNNQBm2dhjX.js"></script>
  </body>
</html>
